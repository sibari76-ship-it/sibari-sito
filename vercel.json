{
  "redirects": [
    { "source": "/chi-sono", "destination": "/chi-sono.html", "permanent": true },
    { "source": "/chi-sono/", "destination": "/chi-sono.html", "permanent": true },
    { "source": "/servizi", "destination": "/servizi.html", "permanent": true },
    { "source": "/servizi/", "destination": "/servizi.html", "permanent": true },
    { "source": "/contatti", "destination": "/contatti.html", "permanent": true },
    { "source": "/contatti/", "destination": "/contatti.html", "permanent": true },
    { "source": "/work", "destination": "/work.html", "permanent": true },
    { "source": "/work/", "destination": "/work.html", "permanent": true },
    { "source": "/faq", "destination": "/faq.html", "permanent": true },
    { "source": "/faq/", "destination": "/faq.html", "permanent": true },
    { "source": "/marketing-monfalcone", "destination": "/marketing-monfalcone.html", "permanent": true },
    { "source": "/marketing-monfalcone/", "destination": "/marketing-monfalcone.html", "permanent": true },
    { "source": "/marketing-grado", "destination": "/marketing-grado.html", "permanent": true },
    { "source": "/marketing-grado/", "destination": "/marketing-grado.html", "permanent": true },
    { "source": "/category/sci/", "destination": "/servizi.html", "permanent": true },
    { "source": "/category/:slug/", "destination": "/", "permanent": true },
    { "source": "/contattami/", "destination": "/contatti.html", "permanent": true },
    { "source": "/", "has": [{"type": "query", "key": "wpr_templates"}], "destination": "/", "permanent": true }
